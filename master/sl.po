#: plugins/kickstart.py:57
msgid "Install packages defined in a kickstart file on your system"
msgstr "Namesti pakete določene v datoteki kickstart na vašem sistemu"

#: plugins/kickstart.py:62
msgid "kickstart file"
msgstr "datoteka kickstart"

#: plugins/kickstart.py:80
#, python-format
msgid "file cannot be parsed: %s"
msgstr "datoteke ni možno razčleniti :%s"

#: plugins/rpm_conf.py:71
#, python-brace-format
msgid "Adding '{}' to list of handling packages for rpmconf"
msgstr "Dodajanje '{}' na seznam paketov za obdelavo za rpmconf"

#: plugins/rpm_conf.py:77
msgid ""
"rpmconf plugin will not run in non-interactive mode without unattended mode"
msgstr ""
"Vtičnik rpmconf se ne bo izvedel v neinteraktivnem načinu brez načina brez "
"nadzora"

#: plugins/rpm_conf.py:92
msgid "ignoring sys.exit from rpmconf due to missing MERGE variable"
msgstr ""
"ignoriranje klica sys.exit iz rpmconf zaradi manjkajoče spremenljivke MERGE"

#: plugins/rpm_conf.py:96
msgid "ignoring sys.exit from rpmconf due to missing file"
msgstr "ignoriranje sys.exit iz rpmconf zaradi manjkajoče datoteke"

#: plugins/showvars.py:46
msgid "show all active dnf variables"
msgstr "pokaži vse aktivne spremenljivke dnf"

#: plugins/snapper.py:56
#, python-format
msgid "connect to snapperd failed: %s"
msgstr "neuspela povezava na snapperd: %s"

#: plugins/snapper.py:62
msgid "creating pre_snapshot"
msgstr "ustvarjanje pre_snapshot"

#: plugins/snapper.py:69
#, python-format
msgid "created pre_snapshot %d"
msgstr "ustvarjeno: pre_snapshot %d"

#: plugins/snapper.py:73
#, python-format
msgid "creating pre_snapshot failed: %s"
msgstr "neuspelo ustvarjanje pre_snapshot: %s"

#: plugins/snapper.py:82
msgid "skipping post_snapshot because creation of pre_snapshot failed"
msgstr "preskakujem post_snapshot, ker izdelava pre_snapshot ni uspela"

#: plugins/snapper.py:88
msgid "creating post_snapshot"
msgstr "ustvarjanje post_snapshot"

#: plugins/snapper.py:94
#, python-format
msgid "created post_snapshot %d"
msgstr "ustvarjen post_snapshot %d"

#: plugins/snapper.py:98
#, python-format
msgid "creating post_snapshot failed: %s"
msgstr "neuspelo ustvarjanje post_snapshot: %s"

#: plugins/torproxy.py:31
msgid "Disabling torproxy plugin: cannot connect to the Tor network"
msgstr "Onemogočanje vtičnika torproxy: povezava z omrežjem Tor ni mogoča"

#: plugins/tracer.py:69
msgid "For more information run:"
msgstr "Za več informacij zaženite:"

#: plugins/tracer.py:96
msgid "Call to Tracer API ended unexpectedly:"
msgstr "Klic vmesnika Tracer API se je nepričakovano končal:"

#: plugins/tracer.py:98
msgid ""
"Please visit https://github.com/FrostyX/tracer/issues and submit the issue. "
"Thank you"
msgstr ""
"Obiščite https://github.com/FrostyX/tracer/issues in prijavite težavo. Hvala "
"lepa"

#: plugins/tracer.py:100
msgid "We apologize for any inconvenience"
msgstr "Opravičujemo se za morebitne nevšečnosti"
